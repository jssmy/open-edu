{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vue-tsc --noEmit && vite build",
        "dev": "vite",
        "lint": "eslint resources/js",
        "format": "prettier --check resources/js",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "e2e": "playwright test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "^2.5.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.12.0",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.0.0",
        "vitest": "^5.1.0",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.14"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@fullcalendar/vue3": "^7.1.3",
        "@inertiajs/vue3": "^3.11.0",
        "@tiptap/extension-image": "^3.32.2",
        "@tiptap/pm": "^3.32.2",
        "@tiptap/starter-kit": "^3.32.2",
        "@tiptap/vue-3": "^3.32.2",
        "vue": "^3.5.44",
        "vuedraggable": "^4.1.0"
    }
}
